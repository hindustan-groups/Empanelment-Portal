# ════════════════════════════════════════════════════════════════
# HINDUSTAN PROJECTS — BACKEND ENVIRONMENT VARIABLES
# Fill in your real values below
# ════════════════════════════════════════════════════════════════

# ── SERVER ───────────────────────────────────────────────────────
PORT=5000

# ── EMAIL CONFIGURATION (Gmail SMTP) ─────────────────────────────
# Your Gmail address (the one used to send emails)
EMAIL_USER=empanelment@hindustanprojects.in

# Gmail App Password (NOT your regular Gmail password!)
# How to get it:
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification → App Passwords
#   3. Create a new App Password → copy the 16-char code here
EMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# ── ADMIN ALERT EMAIL ─────────────────────────────────────────────
# Email address where admin receives new application alerts
ADMIN_EMAIL=admin@hindustanprojects.in
