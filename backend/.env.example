# ════════════════════════════════════════════════════════════════
# HINDUSTAN PROJECTS — BACKEND ENVIRONMENT VARIABLES
# Fill in your real values below, then rename this file to .env
# ════════════════════════════════════════════════════════════════

# ── SERVER ───────────────────────────────────────────────────────
PORT=5000

# ── EMAIL CONFIGURATION (Gmail SMTP + Alias) ──────────────────────
# Your ACTUAL Gmail address (the one that has 2FA + App Password)
EMAIL_USER=yourname@gmail.com

# Gmail App Password (NOT your regular password!)
# Steps: myaccount.google.com → Security → 2-Step Verification → App Passwords
EMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Your professional alias email (added in Gmail → Settings → Accounts → Send mail as)
# Emails will SHOW as coming from this address
ALIAS_EMAIL=empanelment@hindustanprojects.in

# ── ADMIN ALERT EMAIL ─────────────────────────────────────────────
# Where new application alerts go (can be same as EMAIL_USER)
ADMIN_EMAIL=yourname@gmail.com
