# ════════════════════════════════════════════════════════════════
# HINDUSTAN PROJECTS — BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real secure values
# ════════════════════════════════════════════════════════════════

# ── SERVER CONFIGURATION ──────────────────────────────────────────
PORT=9000
NODE_ENV=production

# ── EMAIL CONFIGURATION (Domain Webmail / Gmail SMTP) ─────────────
# 1. Custom Domain Webmail (industrial@hindustanprojects.in):
SMTP_HOST=mail.hindustanprojects.in
SMTP_PORT=465
EMAIL_USER=industrial@hindustanprojects.in
EMAIL_APP_PASS=your_email_password_here

# 2. Or Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_USER=hindustanprojects0.2@gmail.com
# EMAIL_APP_PASS=sbecchomfbrgkrwx

# Professional sender alias email
ALIAS_EMAIL=industrial@hindustanprojects.in

# Admin alert inbox (receives new application notifications)
ADMIN_EMAIL=empanelment@hindustanprojects.in

# ── SECURITY & AUTHENTICATION SECRETS ─────────────────────────────
# Random secret string for signing JWT session tokens
JWT_SECRET=hipro_vps_jwt_secret_key_99201

# Secure API key for authenticating Admin Panel requests (X-Admin-Key header)
ADMIN_API_KEY=hipro_admin_vps_key_99201
