# ─── BACKEND (Node.js / Express) ─────────────────────────────────────────────
# Copy this file to .env in the /backend folder and fill in your real values.
# NEVER commit the actual .env file to git.

# Port for the Express server
PORT=5000

# Frontend URL for CORS whitelist (your Vercel / custom domain)
FRONTEND_URL=https://empanelment.hindustanprojects.in

# Secret key required in X-Admin-Key header for all admin API calls
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your-strong-random-secret-key-here
