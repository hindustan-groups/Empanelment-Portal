# ════════════════════════════════════════════════════════════════
# HINDUSTAN PROJECTS — BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real secure values
# ════════════════════════════════════════════════════════════════

# ── SERVER CONFIGURATION ──────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── EMAIL CONFIGURATION (Gmail SMTP + Alias) ──────────────────────
# Your ACTUAL Gmail address with 2-Step Verification
EMAIL_USER=your_gmail_address_here@gmail.com

# Gmail App Password (16 characters from Google Security settings)
EMAIL_APP_PASS=your_16_char_app_password_here

# Professional sender alias email
ALIAS_EMAIL=empanelment@hindustanprojects.in

# Admin alert inbox (receives new application notifications)
ADMIN_EMAIL=admin_notifications@hindustanprojects.in

# ── SECURITY & AUTHENTICATION SECRETS ─────────────────────────────
# Random secret string for signing JWT session tokens
JWT_SECRET=your_random_jwt_secret_key_here

# Secure API key for authenticating Admin Panel requests (X-Admin-Key header)
ADMIN_API_KEY=your_secure_admin_api_key_here
