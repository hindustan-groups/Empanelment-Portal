# ════════════════════════════════════════════════════════════════
# HINDUSTAN PROJECTS — BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real secure values
# ════════════════════════════════════════════════════════════════

# ── SERVER CONFIGURATION ──────────────────────────────────────────
PORT=9000
NODE_ENV=production
ALLOWED_ORIGIN=https://empanelment.hindustanprojects.in
PORTAL_BASE_URL=https://empanelment.hindustanprojects.in

# ── EMAIL CONFIGURATION (Domain Webmail / Gmail SMTP) ─────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
EMAIL_USER=info@hindustanprojects.in
EMAIL_APP_PASS=your_email_password_here

# Professional sender alias email
ALIAS_EMAIL=industrial@hindustanprojects.in

# Admin alert inbox (receives new application notifications)
ADMIN_EMAIL=empanelment@hindustanprojects.in

# ── CLOUDINARY API CONFIGURATION ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── SECURITY & AUTHENTICATION SECRETS ─────────────────────────────
JWT_SECRET=your_jwt_secret_key
ADMIN_API_KEY=your_admin_api_key
ADMIN_PASSWORD=your_secure_admin_password_here
